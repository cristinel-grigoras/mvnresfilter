<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>property-paths-war</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <!--
        Test project that uses ${...} property placeholders in:
        - <directory> paths (webResources, resources)
        - <include> patterns
        - <exclude> patterns
        - <targetPath>

        This validates that the plugin resolves Maven properties in all path
        configurations, not just in file contents.
    -->

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <profiles>
        <profile>
            <id>development</id>
            <properties>
                <build.profile.id>development</build.profile.id>
                <config.subdir>config</config.subdir>
                <jbossweb.context>propapp-dev</jbossweb.context>
                <app.display.name>Property Paths App Development</app.display.name>
                <session.timeout>60</session.timeout>
                <auth.provider>keycloak</auth.provider>
                <auth.realm>dev-realm</auth.realm>
                <db.url>jdbc:postgresql://localhost:5432/propapp_dev</db.url>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-war-plugin</artifactId>
                        <version>3.4.0</version>
                        <configuration>
                            <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
                            <nonFilteredFileExtensions>
                                <nonFilteredFileExtension>png</nonFilteredFileExtension>
                                <nonFilteredFileExtension>jpg</nonFilteredFileExtension>
                            </nonFilteredFileExtensions>
                            <webResources>
                                <!-- Profile overlay: WEB-INF descriptors (unfiltered copy) -->
                                <resource>
                                    <directory>${basedir}/profiles/${build.profile.id}</directory>
                                    <includes>
                                        <include>WEB-INF/**</include>
                                    </includes>
                                </resource>
                                <!-- Profile overlay: config files (filtered) -->
                                <resource>
                                    <directory>${basedir}/profiles/${build.profile.id}</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>${config.subdir}/**</include>
                                    </includes>
                                    <excludes>
                                        <exclude>${config.subdir}/*.bak</exclude>
                                    </excludes>
                                </resource>
                            </webResources>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>production</id>
            <properties>
                <build.profile.id>production</build.profile.id>
                <config.subdir>config</config.subdir>
                <jbossweb.context>propapp</jbossweb.context>
                <app.display.name>Property Paths App</app.display.name>
                <session.timeout>30</session.timeout>
                <auth.provider>oidc</auth.provider>
                <auth.realm>prod-realm</auth.realm>
                <db.url>jdbc:postgresql://db.prod:5432/propapp</db.url>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-war-plugin</artifactId>
                        <version>3.4.0</version>
                        <configuration>
                            <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
                            <nonFilteredFileExtensions>
                                <nonFilteredFileExtension>png</nonFilteredFileExtension>
                                <nonFilteredFileExtension>jpg</nonFilteredFileExtension>
                            </nonFilteredFileExtensions>
                            <webResources>
                                <resource>
                                    <directory>${basedir}/profiles/${build.profile.id}</directory>
                                    <includes>
                                        <include>WEB-INF/**</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${basedir}/profiles/${build.profile.id}</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>${config.subdir}/**</include>
                                    </includes>
                                    <excludes>
                                        <exclude>${config.subdir}/*.bak</exclude>
                                    </excludes>
                                </resource>
                            </webResources>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
