<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>complex-war</artifactId>
    <version>2.0.0</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Default values (no profile active) -->
        <app.environment>default</app.environment>
        <db.url>jdbc:h2:mem:default</db.url>
        <db.username>sa</db.username>
        <cache.enabled>false</cache.enabled>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <!-- Never filter binary resources -->
                    <exclude>**/*.png</exclude>
                    <exclude>**/*.jpg</exclude>
                    <exclude>**/*.pdf</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <!-- Copy binary resources without filtering -->
                    <include>**/*.png</include>
                    <include>**/*.jpg</include>
                    <include>**/*.pdf</include>
                </includes>
            </resource>
        </resources>
    </build>

    <profiles>
        <profile>
            <id>development</id>
            <properties>
                <app.environment>development</app.environment>
                <app.display.name>Complex App DEV</app.display.name>
                <app.context>/complex-dev</app.context>
                <session.timeout>120</session.timeout>
                <db.url>jdbc:postgresql://localhost:5432/complexdb_dev</db.url>
                <db.username>dev_user</db.username>
                <hibernate.show_sql>true</hibernate.show_sql>
                <hibernate.hbm2ddl_auto>update</hibernate.hbm2ddl_auto>
                <cache.enabled>true</cache.enabled>
                <cache.ttl>60</cache.ttl>
                <log.level>DEBUG</log.level>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-war-plugin</artifactId>
                        <version>3.4.0</version>
                        <configuration>
                            <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
                            <nonFilteredFileExtensions>
                                <nonFilteredFileExtension>png</nonFilteredFileExtension>
                                <nonFilteredFileExtension>jpg</nonFilteredFileExtension>
                                <nonFilteredFileExtension>gif</nonFilteredFileExtension>
                                <nonFilteredFileExtension>pdf</nonFilteredFileExtension>
                                <nonFilteredFileExtension>woff</nonFilteredFileExtension>
                                <nonFilteredFileExtension>woff2</nonFilteredFileExtension>
                                <nonFilteredFileExtension>ttf</nonFilteredFileExtension>
                            </nonFilteredFileExtensions>
                            <webResources>
                                <!-- 1. Profile-specific security config (plain copy) -->
                                <resource>
                                    <directory>profiles/development</directory>
                                    <includes>
                                        <include>WEB-INF/**</include>
                                    </includes>
                                </resource>
                                <!-- 2. Profile-specific app config (with filtering) -->
                                <resource>
                                    <directory>profiles/development</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>config/**</include>
                                    </includes>
                                </resource>
                                <!-- 3. Filter deployment descriptors with ${...} placeholders -->
                                <resource>
                                    <directory>src/main/webapp</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>WEB-INF/jboss-web.xml</include>
                                    </includes>
                                </resource>
                                <!-- 4. Shared resources common to all profiles (no filtering) -->
                                <resource>
                                    <directory>shared-resources</directory>
                                    <excludes>
                                        <exclude>**/*.bak</exclude>
                                        <exclude>**/README.md</exclude>
                                    </excludes>
                                </resource>
                            </webResources>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>production</id>
            <properties>
                <app.environment>production</app.environment>
                <app.display.name>Complex App</app.display.name>
                <app.context>/complex</app.context>
                <session.timeout>30</session.timeout>
                <db.url>jdbc:postgresql://db.prod.internal:5432/complexdb</db.url>
                <db.username>app_prod</db.username>
                <hibernate.show_sql>false</hibernate.show_sql>
                <hibernate.hbm2ddl_auto>validate</hibernate.hbm2ddl_auto>
                <cache.enabled>true</cache.enabled>
                <cache.ttl>3600</cache.ttl>
                <log.level>WARN</log.level>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-war-plugin</artifactId>
                        <version>3.4.0</version>
                        <configuration>
                            <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
                            <nonFilteredFileExtensions>
                                <nonFilteredFileExtension>png</nonFilteredFileExtension>
                                <nonFilteredFileExtension>jpg</nonFilteredFileExtension>
                                <nonFilteredFileExtension>gif</nonFilteredFileExtension>
                                <nonFilteredFileExtension>pdf</nonFilteredFileExtension>
                                <nonFilteredFileExtension>woff</nonFilteredFileExtension>
                                <nonFilteredFileExtension>woff2</nonFilteredFileExtension>
                                <nonFilteredFileExtension>ttf</nonFilteredFileExtension>
                            </nonFilteredFileExtensions>
                            <webResources>
                                <resource>
                                    <directory>profiles/production</directory>
                                    <includes>
                                        <include>WEB-INF/**</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>profiles/production</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>config/**</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/main/webapp</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>WEB-INF/jboss-web.xml</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>shared-resources</directory>
                                    <excludes>
                                        <exclude>**/*.bak</exclude>
                                        <exclude>**/README.md</exclude>
                                    </excludes>
                                </resource>
                            </webResources>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
