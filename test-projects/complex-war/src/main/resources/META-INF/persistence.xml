<?xml version="1.0" encoding="UTF-8"?>
<!-- Configurație pentru baza de date -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="complexapp" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/ComplexDS</jta-data-source>
        <properties>
            <property name="hibernate.show_sql" value="${hibernate.show_sql}"/>
            <property name="hibernate.hbm2ddl.auto" value="${hibernate.hbm2ddl_auto}"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.jdbc.batch_size" value="25"/>
        </properties>
    </persistence-unit>
</persistence>
