<idea-plugin>
    <id>ro.gs1s.mvnresfilter.mvnresfilter</id>
    <name>Maven Resource Overlay</name>
    <vendor url="https://github.com/cristinel-grigoras">Cristinel Grigoras</vendor>

    <description><![CDATA[
        Processes Maven resource filtering and webResources overlays from active profiles
        during IntelliJ artifact builds. Fixes IDEA-25934 for WAR and JAR projects.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.idea.maven</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Maven Resource Overlay" displayType="BALLOON"/>
        <postStartupActivity implementation="ro.gs1s.mvnresfilter.MavenResourceOverlayStartupActivity"/>
        <toolWindow id="Maven Resource Overlay" factoryClass="ro.gs1s.mvnresfilter.OverlayToolWindowFactory"
                    anchor="bottom" secondary="true"
                    icon="AllIcons.Toolwindows.ToolWindowBuild"/>
    </extensions>

    <projectListeners>
    </projectListeners>
</idea-plugin>
